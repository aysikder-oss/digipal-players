<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- USE_FULL_SCREEN_INTENT: normal permission (auto-granted on install, API 29+).
         Required for full-screen-intent notifications used by RelaunchReceiver to
         start MainActivity from the background (BAL-safe on Android 14 / targetSdk 35). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- POST_NOTIFICATIONS: runtime permission on Android 13+ (API 33+).
         Required for RelaunchReceiver to post the relaunch notification.
         On TV / Fire TV devices this is typically pre-granted or not enforced. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Android TV feature declarations -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:name=".DigipalApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DigipalPlayer"
        android:banner="@drawable/banner"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31">

        <!-- Server Setup Activity (launcher entry point) -->
        <activity
            android:name=".ServerSetupActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.DigipalPlayer.Fullscreen">

            <!-- Standard launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV Leanback launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Player Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.DigipalPlayer.Fullscreen" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Recovers from WebView provider package replacement (SIGKILL with no onDestroy).
             Schedules a 3-second relaunch via BootLaunchService.schedulePlayerLaunch()
             when the WebView provider or Digipal APK itself is updated/replaced. -->
        <receiver
            android:name=".PackageUpdateReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <!-- Digipal APK itself was updated. No <data> needed for MY_PACKAGE_REPLACED. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <!-- WebView provider / Chrome / Trichrome updated or replaced. -->
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_CHANGED" />
                <data android:scheme="package" />
            </intent-filter>
            <!-- Debug-only test action — allows exercising the WebView-replacement recovery
                 path on Android 14+ without needing the protected PACKAGE_REPLACED broadcast.
                 adb shell am broadcast -a com.digipal.signage.debug.SIMULATE_WEBVIEW_PACKAGE_REPLACED -p com.digipal.signage.debug
                 The receiver guards this with BuildConfig.DEBUG so it is a no-op in release builds. -->
            <intent-filter>
                <action android:name="com.digipal.signage.debug.SIMULATE_WEBVIEW_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Foreground service that safely opens MainActivity on boot (API 29+ fix). -->
          <service android:name=".BootLaunchService" android:exported="false" android:directBootAware="true" android:foregroundServiceType="shortService" />

          <!-- Persistent watchdog: polls every 10s, restarts app within 1s of crash. -->
          <service android:name=".WatchdogService" android:enabled="true" android:exported="false" android:foregroundServiceType="mediaPlayback" />


        <!-- Disable Sentry auto-init ContentProvider — we call SentryAndroid.init() manually
             after a DSN null-check so the SDK is inert until SENTRY_DSN secret is configured. -->
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />

        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            android:authorities="${applicationId}.SentryPerformanceProvider"
            tools:node="remove" />

        <!-- Receives relaunch alarms and posts a full-screen-intent notification
             to start MainActivity — the only BAL-safe path on Android 14 / targetSdk 35
             without SCHEDULE_EXACT_ALARM.  android:exported="false" so only the app
             itself can trigger it (via PendingIntent.getBroadcast). -->
        <receiver
            android:name=".RelaunchReceiver"
            android:enabled="true"
            android:exported="false" />


        <!-- Suppress LeakCanary's launcher activity from appearing as a
             separate launcher entry on Android TV / Fire TV home screens.
             LeakCanary is debugImplementation only; this stub is a no-op
             in release builds where the activity does not exist. -->
        <activity
            android:name="leakcanary.internal.activity.LeakLauncherActivity"
            tools:node="remove" />

      </application>
  </manifest>
